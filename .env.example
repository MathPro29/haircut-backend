# Server
PORT=8080
ENV=dev

# Database (ตรงกับ docker-compose.yml)
DATABASE_URL=postgres://barbershop:barbershop@localhost:5432/barbershop?sslmode=disable

# Auth — ต้องเปลี่ยนเป็นค่าที่ปลอดภัยใน production
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# CORS (คั่นด้วยจุลภาค)
CORS_ORIGINS=http://localhost:5173

# บัญชี owner แรกของระบบ (สร้างเฉพาะเมื่อยังไม่มีผู้ใช้ใด ๆ)
OWNER_USERNAME=owner
OWNER_PASSWORD=owner123456
OWNER_NAME=เจ้าของร้าน
